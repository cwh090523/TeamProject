  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88300d563a8b9b546960f39d15562a73, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - "\uB3C4\uC6D0\uD68C\uC7A5\uC5D0 \uC758\uD574 \uD1B5\uCE58\uB418\uC5B4 \uB3C4\uC6D0\uC544\uB798
    \uAD74\uB7EC\uAC00\uB294 \uB3C4\uC6D0\uB9C8\uC744"
  - "\uC624\uB298\uB3C4 \uD3C9\uD654\uB86D\uACE0 \uD55C\uACB0\uAC19\uC740 \uB3C4\uC6D0\uB9C8\uC744\uC5D0\uB294
    \uB3C4\uC6D0\uC778\uC758 \uC7AC\uBBF8\uB97C \uCC45\uC784\uC9C8 \uB3C4\uC6D0 pc\uBC29\uC774
    \uC788\uC5C8\uB2E4."
  - ChangeScene
  - 1
  - "\uB3C4\uC6D0 pc\uBC29\uC740 \uB3C4\uC6D0\uD560\uC544\uBC84\uC9C0 \uB9CC\uD07C
    \uB0A1\uACE0 \uC624\uB798\uB410\uC9C0\uB9CC"
  - "\uB3C4\uC6D0\uD560\uC544\uBC84\uC9C0\uC758 \uC601\uD5A5\uC778\uC9C0"
  - "\uC5B4\uB9B0 \uC544\uC774\uB4E4\uC758 \uBC29\uBB38\uC740 \uB04A\uAE30\uC9C0
    \uC54A\uACE0 \uC788\uC5C8\uB2E4."
  - "\uB3C4\uC6D0 pc\uBC29\uC5D0\uB294"
  - ChangeScene
  - 2
  - AddCharacter
  - 0
  - "\uB9E4\uC77C \uAD6C\uC11D\uC5D0 \uC549\uC544 \uBA54\uC774\uD50C \uC300\uBA39\uC744
    \uD558\uC2DC\uB294 \uB300\uBA38\uB9AC \uC544\uC800\uC528\uC640"
  - "\uB9E4\uC77C \uAD6C\uC11D\uC5D0 \uC549\uC544 \uBA54\uC774\uD50C \uC300\uBA39\uC744
    \uD558\uC2DC\uB294 \uB300\uBA38\uB9AC \uC544\uC800\uC528\uC640"
  - AddCharacter
  - 1
  - "\uD559\uAD50\uAC00 \uB05D\uB0A0\uB54C\uCBE4 pc\uBC29\uC5D0 \uAD81\uC744 \uBC15\uB294
    \uC544\uC774\uC5B8 \uC790\uB974\uBC18 4\uC138\uB4E4\uC774 \uC904\uC744\uC9C0\uC5B4
    \uC549\uC544\uC788\uACE0"
  - AddCharacter
  - 2
  - "\uC5B4\uBA38\uB2C8\uAC00 \uC81C\uBC1C \uCDE8\uC5C5\uCACC \uD558\uB77C\uBA70
    \uC6B8\uACE0\uBD80\uB294 \uC2E4\uC2DC\uAC04 \uACE0\uB824\uC7A5 \uC11C\uBE44\uC2A4
    \uC6B4\uC601\uC7A5 \uAE40\uCD98\uBC30\uC528\uB3C4 \uCC3E\uC544\uC628\uB2E4."
  - Remove
  - "\uADF8\uB85C\uC778\uD574 \uB3C4\uC6D0 pc\uBC29\uC758 \uD0A4\uBCF4\uB4DC \uB4E4\uC740
    \uC274\uC0C8\uC5C6\uC774 \uB20C\uB9AC\uAE30 \uBC14\uBE74\uACE0"
  - "\uD0A4\uBCF4\uB4DC \uC548\uC5D0 \uCD95\uC804\uAE30\uB4E4\uC740 \uB9E4\uC77C\uB9E4\uC77C
    \uB20C\uB9AC\uBA70"
  - "\uC11C\uB85C\uC758 \uD3C9\uD589\uD310\uACFC \uC0AC\uB791\uC744 \uB098\uB204\uC5C8\uB2E4"
  - "\uADF8\uB7EC\uB098 \uADF8\uB7F0 \uB728\uAC81\uACE0 \uACA9\uD55C \uC0AC\uB791\uC18D\uC5D0\uC11C\uB3C4
    \uC720\uC77C\uD558\uAC8C \uC0AC\uB791\uBC1B\uC9C0 \uBABB\uD558\uB294 \uC790\uB9AC\uAC00
    \uC788\uC5C8\uB294\uB370"
  - "\uBC14\uB85C \uD654\uC7A5\uC2E4 \uC55E \uC790\uB9AC\uC600\uB2E4."
  - "\uD654\uC7A5\uC2E4 \uBC14\uB85C \uC55E\uC5D0 \uC704\uCE58\uD55C \uC790\uB9AC\uB294
    \uC9C0\uB3C5\uD55C \uB0C4\uC0C8\uB85C \uB4A4\uB36E\uC5EC \uC788\uACE0"
  - ChangeScene
  - 3
  - "\uD0A4\uBCF4\uB4DC\uC5D0\uB294 \uB048\uC801\uD558\uACE0 \uC9C8\uCC99\uAC70\uB9AC\uB294
    \uC815\uCCB4\uB97C \uC54C\uC218\uC5C6\uB294 \uAE30\uBD84\uB098\uC05C \uC5D1\uCCB4\uB4E4\uC774
    \uB20C\uB7EC\uBD99\uC5B4"
  - "\uD0A4\uB97C \uB204\uB97C\uB54C\uB9C8\uB2E4 \uCC0C\uAC71\uCC0C\uAC71 \uC18C\uB9AC\uAC00
    \uB4E4\uB824 \uBD88\uCF8C\uD588\uB2E4"
